#!/usr/bin/env bash
set -eu

root=${0%/tests/run}
if [ -z "$root" ] || [ "$root" = "$0" ]; then
  root=.
fi

: "${RADIO_VERBATIM_TRANSCRIPT:?RADIO_VERBATIM_TRANSCRIPT must point at the local Codex JSONL transcript source}"
: "${RADIO_BROWSER_TEST_LICENSE_KEY:?RADIO_BROWSER_TEST_LICENSE_KEY must contain a live paid or special-use key}"
: "${RADIO_BROWSER_TEST_URL:=https://radio.vandrowka.com/}"

node --test "$root/tests/verbatim-corpus-disproof.mjs"
