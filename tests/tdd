#!/usr/bin/env bash
set -eu

root=${0%/tests/tdd}
if [ -z "$root" ] || [ "$root" = "$0" ]; then
  root=.
fi

mode=${1:-}
if [ $# -gt 0 ]; then
  shift
fi

case "$mode" in
  red)
    if [ $# -eq 0 ]; then
      echo "usage: tests/tdd red <command...>" >&2
      exit 2
    fi
    set +e
    "$@"
    status=$?
    set -e
    if [ "$status" -eq 0 ]; then
      echo "red expected failure but command passed" >&2
      exit 1
    fi
    ;;
  green)
    if [ $# -eq 0 ]; then
      set -- bash "$root/tests/run"
    fi
    "$@"
    ;;
  *)
    echo "usage: tests/tdd red <command...> | tests/tdd green [command...]" >&2
    exit 2
    ;;
esac
